#!/bin/bash
# Runs macelium setup, the test build of macelium in $STUB_MACELIUM, with its
# bootstrap and init's capture stubbed: each records its call and whether
# stdin is a terminal, bootstrap exits $STUB_MACELIUM_STATUS, and the capture
# writes a repo with macelium.conf and nothing committed, as the real one
# does. With --init <path>, it only writes that repo.
if [[ ${1:-} == --init ]]; then
  mkdir -p "$2" && printf 'contract 1\n' >"$2/macelium.conf" && git init -q -b main "$2"
  exit
fi
MACELIUM_HARNESS_STUB_SETUP=1 exec "$STUB_MACELIUM" setup "$@"
