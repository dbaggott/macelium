#!/bin/bash
# Records the call, reading any Brewfile on stdin. `bundle cleanup` lists $STUB_BREW_UNLISTED, a formula a
# line, as installed but not listed; `bundle check` without --no-upgrade lists $STUB_BREW_OUTDATED, an entry
# a line as brew bundle check names it ("Formula <name>"), as having an upgrade; every other check finds
# nothing. A plain `bundle --file=<path>` prints $STUB_BREW_BUNDLE_OUTPUT, then fails when
# $STUB_BREW_BUNDLE_FAILS is set. `upgrade` fails when $STUB_BREW_UPGRADE_FAILS is set, `--prefix` prints
# $STUB_BREW_PREFIX, `--cache` prints $STUB_BREW_CACHE, and `bundle dump` prints $STUB_BREW_DUMP.
echo "brew $*" >>"$STUB_LOG"
if [[ ${1:-} == bundle && ${2:-} == dump ]]; then
  [[ -n ${STUB_BREW_DUMP:-} ]] && printf '%s\n' "$STUB_BREW_DUMP"
  exit 0
fi
for arg in "$@"; do
  if [[ $arg == --file=- ]]; then cat >/dev/null; fi
done
case ${1:-} in
  --prefix)
    echo "${STUB_BREW_PREFIX:?}"
    ;;
  --cache)
    echo "${STUB_BREW_CACHE:?}"
    ;;
  upgrade)
    if [[ -n ${STUB_BREW_UPGRADE_FAILS:-} ]]; then
      echo "Error: $2: the upgrade failed" >&2
      exit 1
    fi
    ;;
  bundle)
    case ${2:-} in
      check)
        if [[ -n ${STUB_BREW_OUTDATED:-} && " $* " != *" --no-upgrade "* ]]; then
          while IFS= read -r entry; do
            echo "→ $entry needs to be installed or updated."
          done <<<"$STUB_BREW_OUTDATED"
          exit 1
        fi
        ;;
      cleanup)
        if [[ -n ${STUB_BREW_UNLISTED:-} ]]; then
          echo "Would uninstall formulae:"
          printf '%s\n' "$STUB_BREW_UNLISTED"
          exit 1
        fi
        ;;
      --file=*)
        [[ -n ${STUB_BREW_BUNDLE_OUTPUT:-} ]] && printf '%s\n' "$STUB_BREW_BUNDLE_OUTPUT"
        if [[ -n ${STUB_BREW_BUNDLE_FAILS:-} ]]; then
          echo "Error: the bundle failed" >&2
          exit 1
        fi
        ;;
    esac
    ;;
esac
exit 0
