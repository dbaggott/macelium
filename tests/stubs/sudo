#!/bin/bash
# Records the call, and runs a command as this user. When $STUB_SUDO_ASKS is
# set, it acts as sudo with no cached credentials: `-n` fails, and `-v` prints
# a prompt, answering it itself.
echo "sudo $*" >>"$STUB_LOG"
case ${1:-} in
  -n) [[ -z ${STUB_SUDO_ASKS:-} ]]; exit ;;
  -v)
    if [[ -n ${STUB_SUDO_ASKS:-} ]]; then echo "STUB sudo Password:"; fi
    exit 0
    ;;
esac
"$@"
